<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top part with Label & Logo text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sprout"
            android:textColor="#386B40"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE PLANT"
            android:textColor="#386B40"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="#DCE6D3"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Main side-by-side content: Plant is the primary focus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left Column: Large Plant Photo & Water Button aligned together -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="12dp"
            android:layout_marginRight="12dp">

            <ImageView
                android:id="@+id/widget_plant_image"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground"
                android:background="#DCE5D5"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/widget_water_button"
                android:layout_width="84dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_button_background"
                android:text="Water"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Right Column: Details, stats, and hydration level progress -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_plant_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="..."
                android:textColor="#191D17"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_plant_last_watered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last watered: -"
                android:textColor="#424940"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/widget_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hydration: 0%"
                android:textColor="#386B40"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="3dp" />

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#386B40"
                android:progressBackgroundTint="#DCE5D5" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
